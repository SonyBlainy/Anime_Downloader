.painel_animes {
    layout: grid;
    grid-size: 5;
    overflow-y: auto;
    grid-rows: auto;
    grid-gutter: 2;
    .cartao-anime {
        align: center top;
        height: auto;
        width: 100%;
        .poster {
            width: auto;
            height: auto;
            box-sizing: content-box;
            border: solid $background;
            &.selecionado {
                border: solid white;
            }
        }
        .nome_anime {
            text-align: center;
            width: 100%;
        }
    }
  }

#anime_info_frame {
    layout: grid;
    grid-size: 2;
    grid-columns: 44 auto;
    #nome_anime {
        width: 100%;
    }
    .poster {
        width: 100%;
    }
}

.n_animes_frame {
    height: auto;
    width: 100%;
    column-span: 5;
    .n_animes {
        text-align: right;
        width: 100%;
        height: auto;
    }
}


AnimePesquisa {
    align: center middle;
    #pesquisa {
      width: 100%;
    }
  }
